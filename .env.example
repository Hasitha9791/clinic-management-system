# Port on which the Express server runs
PORT=5000

# SUPABASE PRODUCTION DATABASE CONFIGURATION
# Fill in these values to switch from local SQLite to cloud Supabase PostgreSQL.
# If these are left blank or omitted, the server automatically falls back to the local SQLite database (clinic.db).
SUPABASE_URL=
SUPABASE_KEY=

# TWILIO API SETTINGS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

